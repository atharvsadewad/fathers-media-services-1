import { MetadataRoute } from "next";

export default function sitemap(): MetadataRoute.Sitemap {
  const base = "https://fathersmedia.in";

  return [
    {
      url: base,
      lastModified: new Date(),
    },
    {
      url: `${base}/about`,
      lastModified: new Date(),
    },
    {
      url: `${base}/services`,
      lastModified: new Date(),
    },
    {
      url: `${base}/portfolio`,
      lastModified: new Date(),
    },
    {
      url: `${base}/plans`,
      lastModified: new Date(),
    },
    {
      url: `${base}/contact`,
      lastModified: new Date(),
    },
    {
      url: `${base}/internship`,
      lastModified: new Date(),
    },
    {
      url: `${base}/verify`,
      lastModified: new Date(),
    },
  ];
}
